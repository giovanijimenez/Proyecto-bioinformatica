# ==========================================
# Bioinformática
# ==========================================

# Archivos de secuenciación pesados
# (Evita subir datos reales de gran tamaño)
*.fastq
*.fastq.gz
*.fq
*.fq.gz

# Archivos de alineamiento
*.bam
*.sam
*.bai

# Archivos de variantes
*.vcf
*.vcf.gz

# Archivos temporales FASTA
*.tmp.fasta

# ==========================================
# Resultados generados automáticamente
# ==========================================

# Mantener la carpeta resultados,
# pero ignorar archivos temporales
resultados/*.tmp
resultados/*.log

